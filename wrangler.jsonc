{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  // Role recheck runs in small batches (see src/recheck.ts); each person is still checked once a day.
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "team-hub", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": {
    "HUB_ORIGIN": "https://team.rescene-remine.com",
    "DISCORD_CLIENT_ID": "1420078078511550657",
    "DISCORD_GUILD_ID": "1546419001041748068",
    "DISCORD_ROLE_ID": "1546422674035707944"
  },
  "routes": [{ "pattern": "team.rescene-remine.com", "custom_domain": true }]
}
