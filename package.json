{
  "name": "team-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/todo-view.ts --bundle --minify --format=iife --global-name=TodoView --target=es2020 --outfile=public/todo-view.js",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler d1 migrations apply team-hub --remote && wrangler deploy --define ASSET_V:\\\"$(cat public/todo.js public/todo-view.js public/todo.css | sha1sum | cut -c1-10)\\\"",
    "check": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "keygen": "node scripts/keygen.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
